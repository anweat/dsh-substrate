+/**
+ * Give a later claimant of a taken entry id its package-derived id instead.
+ *
+ * Two packages that hardcode the same id cannot be installed together today:
+ * `EntryGroup.update` rejects the id list before it reads `disabled`, and a
+ * patch layer cannot rename a row, so neither the user nor a plugin has a
+ * lever. Rewriting here, before any patch reads the rows, gives both rows a
+ * distinct and still-addressable id.
+ *
+ * The id comes from the package name rather than a bare counter, so the
+ * rewritten row keeps a predictable name a patch layer can still target. One
+ * package legitimately contributes several rows — the shipped browser bundle
+ * inserts three — so a derived id that is itself taken falls back to an
+ * ordinal. Measured against four published browser plugins that all hardcode
+ * `id: browser`: without this the profile does not boot, with it all six of
+ * their rows mount.
+ *
+ * The first claimant always keeps the contested id, so anything already
+ * targeting it lands where it did before.
+ */
+function resolveDuplicateEntryIds(data, log) {
+	const seen = new Set();
+	for (const row of data) {
+		if (row.id === undefined) continue;
+		if (!seen.has(row.id)) {
+			seen.add(row.id);
+			continue;
+		}
+		if (typeof row.name !== "string") continue;
+		const base = row.name.replace(/^@/, "").replace(/[^a-zA-Z0-9]+/g, "-").replace(/^-|-$/g, "").toLowerCase();
+		if (base === "") continue;
+		let derived = base;
+		let ordinal = 2;
+		while (seen.has(derived)) {
+			derived = `${base}-${ordinal}`;
+			ordinal += 1;
+		}
+		log(`entry id "${row.id}" already taken; ${row.name} mounted as "${derived}"`);
+		row.id = derived;
+		seen.add(derived);
+	}
+}
