{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "allowImportingTsExtensions": false,
    "rootDir": "src"
  },
  "include": ["src"]
}
