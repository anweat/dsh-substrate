{
  "name": "@anweat/dsh-substrate",
  "version": "0.1.2",
  "type": "module",
  "description": "Diagnoses DeepSeek Harness plugin conflicts and guides a version-locked external repair when one is available.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anweat/dsh-substrate.git"
  },
  "homepage": "https://github.com/anweat/dsh-substrate#readme",
  "bugs": {
    "url": "https://github.com/anweat/dsh-substrate/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "compatibility",
    "diagnostics"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./check": "./src/check.mjs",
    "./repair": "./src/repair.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "bin": {
    "dsh-substrate": "./src/repair.mjs",
    "dsh-substrate-check": "./src/check.mjs"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "CONTRACT.md",
    "README.md",
    "TESTED.md",
    "patches"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.22.14"
  }
}
