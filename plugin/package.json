{
  "name": "@anweat/dsh-substrate",
  "version": "0.1.0",
  "type": "module",
  "description": "Reports and resolves DeepSeek Harness plugin conflicts. Says plainly which ones it cannot.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./check": "./src/check.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.cjs"
    }
  },
  "bin": {
    "dsh-substrate-check": "./src/check.mjs"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "CONTRACT.md",
    "TESTED.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.22.14"
  }
}
