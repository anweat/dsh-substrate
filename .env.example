# A DeepSeek Harness checkout. Needed by experiments/, e2e/, and the baseline
# generator; nothing under substrate/ reads it.
DSH_ROOT=/path/to/deepseek-harness

# The scanner's working root, holding data/baseline.json and out/records.jsonl.
# Defaults to ./pipeline. The per-repository extraction under out/ is not
# published; pipeline/ reproduces it from public sources.
# DSH_ECO=./pipeline

# Where 12-package.mjs writes the published aggregate, if you run it.
# DSH_EVIDENCE=/path/to/dsh-ecosystem-conflicts
